# ───────────────────────────────────────────────────────────────────────────
# Poruchka environment variables. Lines below marked [api] go in apps/api/.env,
# lines marked [web] go in apps/web/.env.local. Fill in real values.
# NEVER put real secrets in this file — it is committed to git. Placeholders only.
# ───────────────────────────────────────────────────────────────────────────

# --- [api] Database (Supabase Postgres) ---
# Pooled connection (Transaction pooler, port 6543) used by the running app:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / direct connection (port 5432) used by Prisma Migrate:
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- [api] Supabase Auth (for verifying web-admin JWTs in the API) ---
# The API verifies access tokens against this project's public JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json), so no Supabase secret is needed here.
SUPABASE_URL="https://<ref>.supabase.co"

# --- [api] Telegram (pilot channel) ---
# Create a bot with @BotFather, paste the token here:
TELEGRAM_BOT_TOKEN="<bot-token>"
# Run long polling in exactly one worker. Set false for web/API-only instances.
TELEGRAM_POLLING_ENABLED="true"

# --- [api] Runtime ---
PORT="3001"
# Comma-separated list of browser origins allowed to call the API (CORS).
# Leave unset in development — http://localhost:3002 is allowed automatically.
CORS_ORIGINS="https://<your-web-host>"
# Unauthenticated dev endpoints (/dev/link, /dev/test-reminder) for driving a local
# pilot. Leave UNSET/false everywhere except your own machine — they can bind any
# user's Telegram to any chat. Only "true" registers them.
ENABLE_DEV_ENDPOINTS="false"

# --- [web] Web admin (apps/web/.env.local) — all three are required or login is dead ---
# Same project as SUPABASE_URL above:
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# Supabase's current publishable key (Dashboard > Project Settings > API Keys).
# Older projects that still issue a legacy JWT anon key may use the name
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead — the app reads either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...>"
# Base URL of the NestJS API. Defaults to http://localhost:3001 if unset.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Public origin of the web admin itself. Used for metadataBase, robots.txt and
# sitemap.xml. Defaults to https://poruchka.bg — set it if the real domain
# differs, or every canonical/sitemap URL points at the wrong host.
NEXT_PUBLIC_SITE_URL="https://poruchka.bg"

# ───────────────────────────────────────────────────────────────────────────
# Not yet read by any code (roadmap: Telegram webhook mode, Viber).
# Kept here because code comments still reference them. Leave commented out —
# do not provision these for launch.
# ───────────────────────────────────────────────────────────────────────────
# [api] Random string sent as Telegram's secret_token header to authenticate
# webhook calls. There is no webhook handler yet; the bot uses long polling.
#TELEGRAM_WEBHOOK_SECRET="<random-string>"
# [api] Viber (parallel track, fill once commercial bot access is granted):
#VIBER_AUTH_TOKEN=""
# [api] Public HTTPS base URL of the API (for registering a Telegram/Viber webhook):
#PUBLIC_API_URL="https://<your-api-host>"

# --- One-tap order links (apps/api) ---
# Signs the /o/<token> confirm links so an order can be confirmed from SMS or a
# pasted Viber message with no account and no app. Min 16 chars. There is no
# default on purpose: a predictable key would let anyone mint a link for any
# order. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_LINK_SECRET="<random-32-bytes>"
# Public base URL of the WEB admin, used to build those links:
PUBLIC_WEB_URL="https://<your-web-host>"
