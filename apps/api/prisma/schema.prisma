// Poruchka data model — multi-tenant from day one.
//
// TENANT ISOLATION: currently enforced ENTIRELY in the application layer — every
// query filters by tenantId (via the TenantId decorator + ensureOwned/getOwned).
// Postgres RLS is NOT yet in force: some order tables have ROW LEVEL SECURITY
// enabled but there are no CREATE POLICY statements, and the app connects as the
// table owner (which bypasses RLS). Do not rely on the database as a tenant
// backstop until real policies + a per-request tenant GUC are added. See
// docs/AUDIT-2026-07-31.md §3 for the plan to make RLS real before onboarding a
// second tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ChatChannel {
  TELEGRAM
  VIBER
  WHATSAPP
}

enum OrderRunStatus {
  PENDING
  SUBMITTED
  ESCALATED
  SKIPPED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
}

/// A restaurant. Top-level tenant; everything else is scoped to it.
model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  timezone           String   @default("Europe/Sofia")
  quietHoursStart    Int      @default(22) // local hour 0-23 — no nudges from here…
  quietHoursEnd      Int      @default(8) // …until here
  renudgeIntervalMin Int      @default(60)
  maxNudges          Int      @default(5)
  language           String   @default("bg") // bot message language: "bg" | "en"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users      User[]
  suppliers  Supplier[]
  items      Item[]
  orderRules OrderRule[]
  orderRuns  OrderRun[]
  messages   MessageLog[]

  @@map("tenants")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  role           Role        @default(STAFF)
  chatChannel    ChatChannel @default(TELEGRAM)
  chatUserId     String? // telegram chat id / viber id — set after linking
  linkCode       String?     @unique // one-time code used to link the chat account
  supabaseAuthId String?     @unique @db.Uuid // present for web-admin login users
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  assignedOrderRules   OrderRule[] @relation("OrderRuleAssignee")
  escalationOrderRules OrderRule[] @relation("OrderRuleEscalation")
  assignedOrderRuns    OrderRun[]  @relation("OrderRunAssignee")
  submittedOrderRuns   OrderRun[]  @relation("OrderRunSubmitter")

  @@index([tenantId])
  @@unique([tenantId, chatChannel, chatUserId])
  @@map("users")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      Item[]
  orderRules OrderRule[]
  orderRuns  OrderRun[]

  @@index([tenantId])
  @@map("suppliers")
}

model Item {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  unit       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderRuleLines OrderRuleLine[]
  orderRunLines  OrderRunLine[]

  @@index([tenantId])
  @@index([supplierId])
  @@map("items")
}

/// A recurring supplier order plan. Lines are grouped because restaurants place
/// one order with a supplier, not one independent order per item.
model OrderRule {
  id                         String    @id @default(uuid()) @db.Uuid
  tenantId                   String    @db.Uuid
  supplierId                 String    @db.Uuid
  assignedUserId             String    @db.Uuid
  escalationUserId           String?   @db.Uuid
  reminderTimeOfDay          String
  recurrence                 Json
  cutoffTime                 String?
  expectedDeliveryOffsetDays Int?
  active                     Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  archivedAt                 DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  assignedUser   User            @relation("OrderRuleAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  escalationUser User?           @relation("OrderRuleEscalation", fields: [escalationUserId], references: [id], onDelete: SetNull)
  lines          OrderRuleLine[]
  runs           OrderRun[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@index([supplierId])
  @@index([assignedUserId])
  @@index([escalationUserId])
  @@map("order_rules")
}

model OrderRuleLine {
  id              String   @id @default(uuid()) @db.Uuid
  orderRuleId     String   @db.Uuid
  itemId          String   @db.Uuid
  defaultQuantity Decimal? @db.Decimal(12, 3)
  unit            String?
  notes           String?
  sortOrder       Int      @default(0)

  orderRule OrderRule @relation(fields: [orderRuleId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([orderRuleId, itemId])
  @@index([orderRuleId])
  @@index([itemId])
  @@map("order_rule_lines")
}

/// One due supplier order. Item data is snapshotted so historical orders stay
/// truthful when catalog items or recurring plans change later.
model OrderRun {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  orderRuleId          String         @db.Uuid
  supplierId           String         @db.Uuid
  assignedUserId       String         @db.Uuid
  dueDate              DateTime       @db.Date
  dueAt                DateTime
  expectedDeliveryDate DateTime?      @db.Date
  status               OrderRunStatus @default(PENDING)
  sentCount            Int            @default(0)
  lastSentAt           DateTime?
  nextNudgeAt          DateTime?
  postponedCount       Int            @default(0)
  lastPostponedAt      DateTime?
  postponedUntil       DateTime?
  submittedAt          DateTime?
  submittedByUserId    String?        @db.Uuid
  skipReason           String?
  supplierConfirmedAt  DateTime?
  supplierReference    String?
  receivedAt           DateTime?
  receivingNote        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict (not Cascade): an OrderRun is the system-of-record for a placed order
  // (prices, receipts, supplier refs). Deleting a plan must never erase order history.
  orderRule       OrderRule      @relation(fields: [orderRuleId], references: [id], onDelete: Restrict)
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  assignedUser    User           @relation("OrderRunAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  submittedByUser User?          @relation("OrderRunSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  lines           OrderRunLine[]

  @@unique([orderRuleId, dueDate])
  @@index([tenantId])
  @@index([tenantId, dueDate])
  @@index([status, nextNudgeAt])
  @@index([supplierId])
  @@index([assignedUserId])
  @@index([submittedByUserId])
  @@map("order_runs")
}

model OrderRunLine {
  id               String   @id @default(uuid()) @db.Uuid
  orderRunId       String   @db.Uuid
  itemId           String   @db.Uuid
  itemNameSnapshot String
  quantitySnapshot Decimal? @db.Decimal(12, 3)
  unitSnapshot     String?
  notesSnapshot    String?
  receivedQuantity Decimal? @db.Decimal(12, 3)
  unitPrice        Decimal? @db.Decimal(12, 2)
  exceptionType    String?
  exceptionNote    String?
  sortOrder        Int      @default(0)

  orderRun OrderRun @relation(fields: [orderRunId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([orderRunId, itemId])
  @@index([orderRunId])
  @@index([itemId])
  @@map("order_run_lines")
}

/// Audit trail of inbound/outbound chat messages, for debugging.
model MessageLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction  String // "out" | "in"
  channel    ChatChannel
  chatUserId String?
  payload    Json
  createdAt  DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@map("message_logs")
}
